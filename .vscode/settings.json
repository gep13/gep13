{
  "cSpell.words": [
    "Ewan",
    "addin",
    "addins",
    "cakebuildnet",
    "cakecontrib"
  ],
  "[markdown]": {},

  // Paste a screenshot (or drag an image file) into a blog post .md and VS Code
  // copies it into the repo and inserts a relative ![](...) link automatically.
  // Images land under src/assets/ so Astro OPTIMIZES them on build (WebP/AVIF,
  // hashing, width/height) — that only happens for src/ assets, not public/.
  //
  // Glob key is tail-anchored ("**/content/blog/**/*") so it matches regardless
  // of workspace root or a leading slash — a "/src/content/blog/**/*" key can
  // silently fail to match, and VS Code then falls back to dumping "image.png"
  // next to the post. IMPORTANT: settings changes here need a window reload to
  // take effect (Command Palette -> "Developer: Reload Window").
  //
  // Layout: src/assets/blog/<post-slug>/<pasted-name>
  //   ${documentBaseName} = post filename without .md (the slug / folder)
  //   ${fileName}         = pasted file name (clipboard shots -> image.png,
  //                         then image-1.png, image-2.png via nameIncrementally)
  // The built-in does NOT prompt for a name. To give an image a descriptive
  // name: paste it, then rename the file FROM THE VS CODE EXPLORER (F2 there,
  // not on disk) — updateLinksOnFileMove (below) rewrites the ![](...) link.
  "markdown.copyFiles.destination": {
    "**/content/blog/**/*": "${documentWorkspaceFolder}/src/assets/blog/${documentBaseName}/${fileName}"
  },
  "markdown.copyFiles.overwriteBehavior": "nameIncrementally",
  "markdown.updateLinksOnFileMove.enabled": "always"
}
